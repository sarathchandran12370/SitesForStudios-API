PORT=4000
APP_URL=http://localhost:5173
# Domain that partner custom domains CNAME to (production)
SITES_CNAME_TARGET=sites.sitesforstudios.com

DATABASE_URL=postgres://localhost:5432/sitesforstudios
MONGO_URL=mongodb://127.0.0.1:27017/sitesforstudios

# Change in production: long random strings
JWT_SECRET=dev-jwt-secret-change-me
MEDIA_SIGNING_SECRET=dev-media-secret-change-me

# Storage: "local" (dev, files in server/storage) or "s3"
STORAGE_DRIVER=local
AWS_REGION=ap-south-1
S3_BUCKET=
# Face recognition: "none" (dev) or "rekognition"
FACE_PROVIDER=none

# Razorpay (billing). Leave empty in dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed super admin
SEED_ADMIN_EMAIL=admin@sitesforstudios.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# Production only (written by deploy/instance/deploy.sh on the server)
# ORIGIN_VERIFY_SECRET=      secret header CloudFront adds; requests without it are refused
# DATABASE_SSL_CA=           path to the RDS CA bundle for verified TLS

# Photo processing: photos processed at the same time (1 on small 1 GB servers)
PROCESSING_CONCURRENCY=1

# Notifications. EMAIL_PROVIDER=log only records messages (Super Admin > Sent messages).
EMAIL_PROVIDER=log
EMAIL_FROM=SitesForStudios <no-reply@thaaram.in>
# WhatsApp Business Cloud API (Meta). Template names must be approved in Meta Business Manager.
WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_INVITE=
WHATSAPP_TEMPLATE_PHOTOS_READY=
WHATSAPP_TEMPLATE_ENQUIRY=
WHATSAPP_TEMPLATE_RETENTION=

# Retention: hours between checks (0 = off), months a restore adds, restore price
RETENTION_CHECK_HOURS=1
RESTORE_EXTENDS_MONTHS=6
RESTORE_PRICE_INR=499
